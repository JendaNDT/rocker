<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RockerNativePlatform Condition="'$(RockerNativePlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</RockerNativePlatform>
    <RockerNativePlatform Condition="'$(RockerNativePlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</RockerNativePlatform>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.$(RockerNativePlatform).lock.json</NuGetLockFilePath>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rocker.Notation/Rocker.Notation.csproj" />
    <PackageReference Include="AlphaSkia.Native.Windows" Version="3.4.135" Condition="'$(RockerNativePlatform)' == 'Windows'" />
    <PackageReference Include="AlphaSkia.Native.Linux" Version="3.4.135" Condition="'$(RockerNativePlatform)' == 'Linux'" />
  </ItemGroup>
</Project>
