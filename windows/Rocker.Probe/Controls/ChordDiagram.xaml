<UserControl x:Class="Rocker.Probe.Controls.ChordDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <TextBlock x:Name="ChordTitle" FontSize="22" FontWeight="SemiBold" Style="{StaticResource VintageBodyTextStyle}" />
        <Border Style="{StaticResource VintageInstrumentCardStyle}" Padding="16" HorizontalAlignment="Left">
            <Canvas x:Name="Diagram" Width="200" Height="225" IsHitTestVisible="False" />
        </Border>
        <TextBlock x:Name="Description" Style="{StaticResource VintageSecondaryTextStyle}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
