<UserControl x:Class="Rocker.Probe.Controls.LevelMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6">
        <TextBlock x:Name="MeterLabel" Text="Úroveň vstupu" Style="{StaticResource VintageBodyTextStyle}" />
        <ProgressBar x:Name="Meter" Minimum="0" Maximum="1" Value="0" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
        <TextBlock x:Name="Reading" Text="Bez signálu" Style="{StaticResource VintageSecondaryTextStyle}" />
    </StackPanel>
</UserControl>
