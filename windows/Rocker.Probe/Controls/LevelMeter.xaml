<UserControl x:Class="Rocker.Probe.Controls.LevelMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6">
        <TextBlock x:Name="MeterLabel" Text="Úroveň vstupu" Style="{StaticResource VintageBodyTextStyle}" />
        <Border Background="{ThemeResource VintageMeterWell}" CornerRadius="4" Padding="6"><Grid x:Name="Segments" ColumnSpacing="3" Height="12" IsHitTestVisible="False"/></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="−60" FontSize="10" Style="{StaticResource VintageSecondaryTextStyle}"/><TextBlock Grid.Column="1" Text="−30" FontSize="10" HorizontalAlignment="Center" Style="{StaticResource VintageSecondaryTextStyle}"/><TextBlock Grid.Column="2" Text="0 dBFS" FontSize="10" HorizontalAlignment="Right" Style="{StaticResource VintageSecondaryTextStyle}"/></Grid>
        <ProgressBar x:Name="Meter" Height="2" Minimum="0" Maximum="1" Value="0" Foreground="{ThemeResource VintageAccent}" />
        <TextBlock x:Name="Reading" Text="Bez signálu" Style="{StaticResource VintageSecondaryTextStyle}" />
    </StackPanel>
</UserControl>
