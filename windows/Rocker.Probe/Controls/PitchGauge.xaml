<UserControl x:Class="Rocker.Probe.Controls.PitchGauge"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Viewbox Stretch="Uniform" MaxHeight="98" HorizontalAlignment="Stretch">
  <Canvas x:Name="Scale" Width="320" Height="92" IsHitTestVisible="False">
   <Rectangle Width="28" Height="32" Canvas.Left="146" Canvas.Top="24" Fill="{ThemeResource VintageAccent}" Opacity="0.25" RadiusX="4" RadiusY="4"/>
   <Line X1="24" X2="296" Y1="57" Y2="57" Style="{StaticResource VintageInstrumentLineStyle}"/>
   <Line x:Name="Pointer" X1="160" X2="160" Y1="17" Y2="65" Style="{StaticResource VintageNeedleStyle}"/>
   <Ellipse x:Name="Pivot" Width="6" Height="6" Canvas.Left="157" Canvas.Top="63" Fill="{ThemeResource VintageInstrumentInk}"/>
  </Canvas>
 </Viewbox>
</UserControl>
