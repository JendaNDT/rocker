<UserControl x:Class="Rocker.Probe.Controls.ValueDial"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6" MinWidth="150" MaxWidth="220">
        <TextBlock x:Name="ParameterLabel" Style="{StaticResource VintageBodyTextStyle}" />
        <Canvas Width="80" Height="80" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Ellipse Width="72" Height="72" Canvas.Left="4" Canvas.Top="4" Style="{StaticResource VintageDialFaceStyle}" />
            <Line x:Name="Needle" X1="40" Y1="40" X2="40" Y2="12" Style="{StaticResource VintageNeedleStyle}" />
        </Canvas>
        <NumberBox x:Name="Number" ValueChanged="Number_Changed" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" />
        <Slider x:Name="Position" ValueChanged="Position_Changed" />
    </StackPanel>
</UserControl>
