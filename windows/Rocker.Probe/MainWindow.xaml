<Window
    x:Class="Rocker.Probe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rocker">
    <ContentControl x:Name="ShellInteractionRoot" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="ShellRoot" Background="{ThemeResource VintageBackground}" SizeChanged="Shell_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <MenuBar x:Name="MainMenu">
            <MenuBarItem Title="Soubor">
                <MenuFlyoutItem Text="Otevřít soubor…" Click="OpenFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="Poslední soubory" />
                <MenuFlyoutItem Text="Uložit aktuální práci" Click="SaveCurrent_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Vrátit editaci Studia" Click="UndoCurrent_Click" />
                <MenuFlyoutItem Text="Zobrazit soubor ve složce" Click="RevealFile_Click" />
                <MenuFlyoutItem x:Name="CancelFileMenu" Text="Zrušit načítání" Click="CancelFile_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="OpenMediaMenu" Text="Otevřít nahrávku…" Click="OpenMedia_Click">
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenScoreMenu" Text="Otevřít noty…" Click="OpenScore_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ExportMidiMenu" Text="Uložit MIDI…" Click="ExportMidi_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Zavřít" Click="Close_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Přehrávání">
                <MenuFlyoutItem x:Name="PlayMenu" Text="Přehrát" Click="PlayMedia_Click" IsEnabled="False" />
                <MenuFlyoutItem Text="Zastavit všechny zdroje" Click="Stop_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Zobrazení">
                <MenuFlyoutItem x:Name="BackMenu" Text="Zpět" Click="Back_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Left" Modifiers="Menu" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ForwardMenu" Text="Vpřed" Click="Forward_Click" IsEnabled="False" />
                <MenuFlyoutItem Text="Jen hraju · F11" Click="FocusMode_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F11" /></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem Text="Hledat v Rockeru…" Click="Search_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="K" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem Text="Oblíbené…" Click="Favorites_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Podle Windows" Tag="system" Click="Theme_Click" />
                <MenuFlyoutItem Text="Tmavý Vintage" Tag="dark" Click="Theme_Click" />
                <MenuFlyoutItem Text="Světlý Vintage" Tag="light" Click="Theme_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Nástroje">
                <MenuFlyoutItem Text="Uložit sestavu cvičení…" Click="SaveSetup_Click" />
                <MenuFlyoutItem Text="Moje sestavy cvičení…" Click="Setups_Click" />
                <MenuFlyoutItem Text="Zvuková zařízení" Tag="29" Click="NavigateMenu_Click" />
                <MenuFlyoutItem Text="Nastavení" Tag="28" Click="NavigateMenu_Click" />
                <MenuFlyoutItem Text="Zálohy a soubory" Tag="30" Click="NavigateMenu_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Nápověda"><MenuFlyoutItem Text="Aktualizace…" Click="Updates_Click" /><MenuFlyoutItem Text="Návod k používání" Click="Guide_Click" /><MenuFlyoutItem Text="O aplikaci Rocker" Click="About_Click" /></MenuBarItem>
        </MenuBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" PaneDisplayMode="Auto"
                        OpenPaneLength="192" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="640"
                        SelectionChanged="Navigation_SelectionChanged" BackRequested="Navigation_BackRequested" IsBackButtonVisible="Visible"
                        AutomationProperties.Name="Pracovní pohledy Rockeru">
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,10,8,18" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="28" Height="28" Background="{ThemeResource VintageAccent}" CornerRadius="7">
                            <Viewbox Margin="6"><Path Data="M 3,1 L 13,1 C 19,1 20,10 14,12 L 20,21 L 14,21 L 8,13 L 8,21 L 3,21 Z M 8,5 L 8,9 L 12,9 C 15,9 15,5 12,5 Z" Fill="{ThemeResource VintageAccentForeground}"/></Viewbox>
                        </Border>
                        <TextBlock Text="ROCKER" FontSize="20" CharacterSpacing="70" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource VintageAccent}"/>
                    </StackPanel>
                    <TextBlock Text="KYTAROVÉ STUDIO" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,12,24,24" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="12" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="3" Height="27" CornerRadius="1" Background="{ThemeResource VintageAccent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WorkspaceTitle" Grid.Column="1" Text="Přehled" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel x:Name="WorkspaceTools" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SearchButton" Click="Search_Click" AutomationProperties.Name="Hledat v Rockeru · Ctrl+K" ToolTipService.ToolTip="Hledat v Rockeru · Ctrl+K"><SymbolIcon Symbol="Find"/></Button>
                            <Button x:Name="FavoriteViewButton" Click="FavoriteView_Click" AutomationProperties.Name="Přidat pohled do oblíbených"><FontIcon Glyph="&#xE734;"/></Button>
                            <Button x:Name="FocusExitButton" Content="Zpět · Esc" Click="FocusMode_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WorkspaceTrail" Text="Rocker / Přehled" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar x:Name="ShellNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Rocker"
                             Message="" />
                    <ContentControl x:Name="WorkspaceContent" HorizontalContentAlignment="Stretch">
                        <ContentControl.ContentTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></ContentControl.ContentTransitions>
                    </ContentControl>
                    <StackPanel x:Name="NotationPanel" Visibility="Collapsed" Spacing="12">
                <TextBlock Text="Noty a tabulatury" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Nativní zobrazení a společný přehrávač. Poslech používá syntetický strunný zvuk a bicí; nejde o skutečný kytarový aparát ani zvuk původních nástrojů."
                           TextWrapping="Wrap" />
                <StackPanel x:Name="ScoreButtons" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="XmlButton" Content="Ukázka MusicXML" Click="Xml_Click" />
                    <Button x:Name="GpButton" Content="Ukázka Guitar Pro" Click="Gp_Click" />
                    <Button x:Name="OpenScoreButton" Content="Otevřít noty…" Click="OpenScore_Click" />
                    <Button x:Name="PlayScoreButton" Content="Přehrát noty" Click="PlayScore_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel x:Name="NotationControls" Spacing="8">
                    <ComboBox x:Name="NotationTrackBox" Header="Zobrazená a hraná stopa" DisplayMemberPath="Name" SelectionChanged="NotationTrack_Changed" />
                    <CheckBox x:Name="NotationAllTracks" Content="Přehrávat všechny stopy partitury" Checked="NotationAudio_Changed" Unchecked="NotationAudio_Changed" />
                    <ComboBox x:Name="NotationZoom" Header="Zvětšení not" SelectedIndex="2" SelectionChanged="NotationZoom_Changed">
                        <ComboBoxItem Content="50 %" Tag="0.5" /><ComboBoxItem Content="75 %" Tag="0.75" /><ComboBoxItem Content="100 %" Tag="1" /><ComboBoxItem Content="125 %" Tag="1.25" /><ComboBoxItem Content="150 %" Tag="1.5" /><ComboBoxItem Content="200 %" Tag="2" />
                    </ComboBox>
                    <NumberBox x:Name="NotationBar" Header="Vybraný takt" Minimum="1" Maximum="128" Value="1" SpinButtonPlacementMode="Inline" ValueChanged="NotationBar_Changed" />
                    <CheckBox x:Name="NotationFollow" Content="Sledovat právě hraný takt" IsChecked="True" />
                    <NumberBox x:Name="NotationLoopFirst" Header="Smyčka od taktu" Minimum="1" Maximum="128" Value="1" SpinButtonPlacementMode="Inline" ValueChanged="NotationLoopFirst_Changed" />
                    <NumberBox x:Name="NotationLoopLast" Header="Smyčka do taktu včetně" Minimum="1" Maximum="128" Value="1" SpinButtonPlacementMode="Inline" />
                    <ComboBox x:Name="NotationOccurrence" Header="Průchod opakovaným taktem" />
                    <Button Content="Použít smyčku taktů" Click="NotationLoop_Click" />
                    <Button Content="Vypnout smyčku taktů" Click="NotationLoopOff_Click" />
                    <Button Content="Přejít na vybraný takt" Click="NotationSeek_Click" />
                </StackPanel>
                <TextBlock Text="Rychlost přehrávání měň dole; výška tónů zůstává zachovaná. Zvuk je syntetická pomůcka." TextWrapping="Wrap" />
                <TextBlock x:Name="NotationAccessible" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="NotationStatus" Text="Připravuji notový náhled…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Canvas x:Name="ScoreCanvas" Width="700" Height="1" Background="White" PointerPressed="Score_PointerPressed"
                            AutomationProperties.Name="Notový náhled; výběr taktu kliknutím">
                        <Image x:Name="ScoreImage" Width="700" Stretch="Fill" />
                        <Border x:Name="NotationPlayhead" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="SelectionBox" BorderBrush="{ThemeResource VintageAccent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Canvas>
                </ScrollViewer>
                <TextBlock x:Name="SelectionStatus" Text="Takt zatím není vybraný." TextWrapping="Wrap" />
                <Button x:Name="ExportMidiButton" Content="Uložit MIDI…" Click="ExportMidi_Click" IsEnabled="False" />
                    </StackPanel>
                <Border x:Name="VideoPanel" Style="{StaticResource VintageCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Oficiální YouTube přehrávač. Video a jeho zvuk zůstávají součástí YouTube; žádný zvuk se nestahuje ani nepřevádí." TextWrapping="Wrap" />
                        <TextBox x:Name="VideoUrl" Header="Odkaz na video" PlaceholderText="https://www.youtube.com/watch?v=…" MaxLength="2048" />
                        <StackPanel x:Name="VideoButtons" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="VideoLoadButton" Content="Načíst video" Click="VideoLoad_Click" IsEnabled="False" />
                            <Button x:Name="VideoPlayButton" Content="Přehrát video" Click="VideoPlay_Click" IsEnabled="False" />
                            <Button x:Name="VideoPauseButton" Content="Pozastavit" Click="VideoPause_Click" IsEnabled="False" />
                            <Button x:Name="VideoStopButton" Content="Zastavit video" Click="VideoStop_Click" IsEnabled="False" />
                            <Button Content="V prohlížeči" Click="VideoExternal_Click" />
                        </StackPanel>
                        <ComboBox x:Name="VideoRates" Header="Dostupné rychlosti videa" Width="200" SelectionChanged="VideoRate_Changed" IsEnabled="False" />
                        <Slider x:Name="VideoSeek" Header="Pozice ve videu" Minimum="0" Maximum="1" IsEnabled="False" PointerReleased="VideoSeek_Released" KeyUp="VideoSeek_KeyUp" />
                        <NumberBox x:Name="VideoLoopA" Header="A · začátek v sekundách" Minimum="0" Maximum="864000" Value="0" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="VideoLoopB" Header="B · konec v sekundách" Minimum="0" Maximum="864000" Value="0" SpinButtonPlacementMode="Inline" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="VideoMarkA" Content="A = nyní" Click="VideoMark_Click" Tag="a" IsEnabled="False" />
                            <Button x:Name="VideoMarkB" Content="B = nyní" Click="VideoMark_Click" Tag="b" IsEnabled="False" />
                            <Button x:Name="VideoApplyLoop" Content="Použít A/B" Click="VideoApplyLoop_Click" IsEnabled="False" />
                        </StackPanel>
                        <CheckBox x:Name="VideoLoopEnabled" Content="Opakovat úsek A/B" Checked="VideoLoop_Changed" Unchecked="VideoLoop_Changed" />
                        <TextBox x:Name="VideoLoopLabel" Header="Název úseku" MaxLength="256" />
                        <Button Content="Uložit pojmenovaný úsek" Click="VideoSaveLoop_Click" />
                        <ListView x:Name="VideoSavedLoops" Header="Uložené úseky všech videí" DisplayMemberPath="Title" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Otevřít vybraný úsek" Click="VideoOpenLoop_Click" />
                            <Button Content="Přejmenovat" Click="VideoRenameLoop_Click" />
                            <Button Content="Smazat" Click="VideoDeleteLoop_Click" />
                            <Button Content="Vrátit smazání" Click="VideoUndoLoop_Click" />
                        </StackPanel>
                        <TextBlock x:Name="VideoLoopStatus" Text="YouTube smyčka má přibližné časování; neslouží k přesnému sladění nahrávky." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Nastavit sdílený zvuk Windows pro video" Click="VideoSharedAudio_Click" />
                        <TextBlock Text="YouTube používá sdílený výstup Windows. Pokud s ASIO nebo výhradním WASAPI neslyšíš video, zvol sdílené Windows Audio a stejný interfejs i ve Windows. Nahrávání zachycuje pouze zvolenou nativní sběrnici; zvuk videa se nenahrává." TextWrapping="Wrap" />
                        <TextBlock x:Name="VideoPosition" Text="0:00 / 0:00" />
                        <WebView2 x:Name="VideoView" MaxWidth="640" Height="360" HorizontalAlignment="Stretch" AutomationProperties.Name="Oficiální YouTube přehrávač" />
                        <TextBlock x:Name="VideoStatus" Text="Připravuji přehrávač…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border x:Name="DevicePanel" Style="{StaticResource VintageCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Vyber ovladač, zvukovou kartu a vstup pro kytaru. Změna nastavení zastaví přehrávání; monitoring se nezapíná automaticky."
                                   TextWrapping="Wrap" />
                        <ContentControl x:Name="DeviceControls" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Button Content="Obnovit seznam zařízení (zastaví zvuk)" Click="DevicesRefresh_Click" />
                                <ComboBox x:Name="DeviceBackendBox" Header="Ovladač" HorizontalAlignment="Stretch" SelectionChanged="DeviceBackend_Changed" />
                                <ComboBox x:Name="DeviceInputBox" Header="Vstupní zařízení" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="DeviceNames_Changed" />
                                <ComboBox x:Name="DeviceOutputBox" Header="Výstupní zařízení / sluchátka" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="DeviceNames_Changed" />
                                <Button Content="Načíst možnosti vybrané karty (zastaví zvuk)" Click="DeviceInspect_Click" />
                                <ComboBox x:Name="DeviceChannelBox" Header="Jediný mono vstup kytary" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="DevicePairBox" Header="Výstupní kanály" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="DeviceRateBox" Header="Vzorkování (Hz)" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="DeviceBufferBox" Header="Buffer (vzorky)" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ApplyDeviceButton" Content="Ověřit a použít" IsEnabled="False" Click="DeviceApply_Click" />
                                    <Button x:Name="DevicePanelButton" Content="Panel ovladače" IsEnabled="False" Click="DeviceControlPanel_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                        <TextBlock x:Name="DeviceSelectionStatus" Text="Zařízení zatím není vybrané. První testovací tón použije výchozí výstup; vstup kytary se otevře pouze výslovnou volbou." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Pro kytaru i sluchátka používej stejný interfejs. Direct Monitor na kartě je samostatný poslech bez softwarových efektů. ASIO vyžaduje ovladač výrobce; aplikace ho neinstaluje. Sdílené WASAPI umožňuje zvuk ostatních aplikací, výhradní režim ho může omezit." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="StartButton" Content="Spustit tón" Click="Start_Click" />
                        <TextBlock x:Name="DeviceText" Text="Zařízení zatím není otevřené." TextWrapping="Wrap" />
                        <TextBlock Text="Velikost bufferu není měření celkové odezvy. Zavření okna zastaví zvuk a uvolní zařízení."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
        <Border x:Name="MediaPanel" Grid.Row="2" Background="{ThemeResource VintagePanelMaterial}" Padding="16,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="4">
                <InfoBar x:Name="PracticeRestNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Cvičení" />
                <Grid x:Name="PracticeRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="PracticeButtons" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PracticeStart" Content="Zahájit cvičení" IsEnabled="False" Click="PracticeStart_Click" />
                    <Button x:Name="PracticePause" Content="Pauza cvičení" IsEnabled="False" Click="PracticePause_Click" />
                    <Button x:Name="PracticeEnd" Content="Ukončit cvičení" IsEnabled="False" Click="PracticeEnd_Click" />
                </StackPanel>
                <TextBlock x:Name="PracticeStatus" Text="Cvičení není zahájené · aktivně 0:00" TextWrapping="Wrap" FontSize="12" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="PlanButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="ReturnPlan" Content="Zpět do plánu" Click="ReturnPlan_Click" />
                    <Button x:Name="CompletePlan" Content="Označit blok jako hotový" Click="CompletePlan_Click" />
                    <TextBlock x:Name="PlanTaskLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <Grid x:Name="MediaTransportRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MediaTitle" Text="Připrav nahrávku nebo noty" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <CommandBar x:Name="MediaButtons" Grid.Column="1" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" Background="Transparent">
                        <AppBarButton x:Name="PlayMediaButton" Label="Přehrát" Icon="Play" Click="ToggleMedia_Click" IsEnabled="False" />
                        <AppBarButton x:Name="StopButton" Label="Zastavit" Icon="Stop" AccessKey="Z" Click="Stop_Click" IsEnabled="False" />
                        <AppBarButton Label="Hlasitost" Icon="Volume">
                            <AppBarButton.Flyout><Flyout><Slider x:Name="VolumeSlider" Header="Hlasitost přehrávání" Width="200" Minimum="0" Maximum="100" Value="15" ValueChanged="Volume_Changed" AutomationProperties.Name="Hlasitost přehrávání" /></Flyout></AppBarButton.Flyout>
                        </AppBarButton>
                        <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="OpenMediaButton" Label="Otevřít nahrávku" Icon="OpenFile" Click="OpenMedia_Click" />
                        <AppBarButton x:Name="RewindButton" Label="Na začátek" Icon="Previous" Click="Rewind_Click" IsEnabled="False" />
                        <AppBarButton Label="Rychlost přehrávání" Icon="Setting">
                            <AppBarButton.Flyout><Flyout><StackPanel Spacing="12" Width="220">
                            <ComboBox x:Name="SpeedBox" Header="Rychlost" Width="150" SelectedIndex="3" SelectionChanged="Speed_Changed">
                                <ComboBoxItem Content="0,25×" Tag="0.25" />
                                <ComboBoxItem Content="0,5×" Tag="0.5" />
                                <ComboBoxItem Content="0,75×" Tag="0.75" />
                                <ComboBoxItem Content="1×" Tag="1" />
                                <ComboBoxItem Content="1,5×" Tag="1.5" />
                                <ComboBoxItem Content="2×" Tag="2" />
                            </ComboBox>
                                <TextBlock Text="Nová rychlost se připraví na pozadí; monitoring kytary pokračuje." TextWrapping="Wrap" />
                            </StackPanel></Flyout></AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton Label="Informace o přehrávání" Icon="Help">
                            <AppBarButton.Flyout><Flyout><TextBlock x:Name="MediaStatus" MaxWidth="320" Text="Otevři nahrávku nebo noty přes nabídku Soubor." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Flyout></AppBarButton.Flyout>
                        </AppBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                </Grid>
                <Grid x:Name="MediaSeekRow">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                            KeyDown="Position_KeyDown" KeyUp="Position_KeyUp" AutomationProperties.Name="Pozice přehrávání; změna zastaví zvuk" />
                    <TextBlock x:Name="PositionText" Grid.Column="1" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Padding="16,4" Background="{ThemeResource VintageBackground}">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Připravuji zvuk…" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="GlobalMuteButton" Grid.Column="1" Content="Zastavit zvuk" Click="Stop_Click" Visibility="Collapsed" MinHeight="32" AutomationProperties.Name="Zastavit všechny zvukové zdroje" />
                <TextBlock x:Name="ShellStateText" Grid.Column="2" Text="Rocker" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
    </ContentControl>
</Window>
