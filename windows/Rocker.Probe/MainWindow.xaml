<Window
    x:Class="Rocker.Probe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rocker">
    <Grid x:Name="ShellRoot" Background="{ThemeResource VintageBackground}" SizeChanged="Shell_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <MenuBar>
            <MenuBarItem Title="Soubor">
                <MenuFlyoutItem x:Name="OpenMediaMenu" Text="Otevřít nahrávku…" Click="OpenMedia_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenScoreMenu" Text="Otevřít noty…" Click="OpenScore_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ExportMidiMenu" Text="Uložit MIDI…" Click="ExportMidi_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Zavřít" Click="Close_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Přehrávání">
                <MenuFlyoutItem x:Name="PlayMenu" Text="Přehrát" Click="PlayMedia_Click" IsEnabled="False" />
                <MenuFlyoutItem Text="Zastavit" Click="Stop_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Escape" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Zobrazení">
                <MenuFlyoutItem x:Name="BackMenu" Text="Zpět" Click="Back_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Left" Modifiers="Menu" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ForwardMenu" Text="Vpřed" Click="Forward_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Podle Windows" Tag="system" Click="Theme_Click" />
                <MenuFlyoutItem Text="Tmavý Vintage" Tag="dark" Click="Theme_Click" />
                <MenuFlyoutItem Text="Světlý Vintage" Tag="light" Click="Theme_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Nástroje">
                <MenuFlyoutItem Text="Komponenty Vintage" Click="Components_Click" />
                <MenuFlyoutItem Text="Zvuková zařízení" Tag="29" Click="NavigateMenu_Click" />
                <MenuFlyoutItem Text="Nastavení" Tag="28" Click="NavigateMenu_Click" />
                <MenuFlyoutItem Text="Zálohy a soubory" Tag="30" Click="NavigateMenu_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Nápověda"><MenuFlyoutItem Text="O aplikaci Rocker" Click="About_Click" /></MenuBarItem>
        </MenuBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" PaneDisplayMode="Auto"
                        OpenPaneLength="220" ExpandedModeThresholdWidth="1040" CompactModeThresholdWidth="640"
                        SelectionChanged="Navigation_SelectionChanged" BackRequested="Navigation_BackRequested" IsBackButtonVisible="Visible"
                        AutomationProperties.Name="Pracovní pohledy Rockeru">
            <NavigationView.PaneHeader><TextBlock Text="ROCKER" FontSize="22" FontWeight="SemiBold" Margin="16,12" Foreground="{ThemeResource VintageAccent}" /></NavigationView.PaneHeader>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,12,24,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="WorkspaceTitle" Text="Přehled" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="WorkspaceTrail" Text="Rocker / Přehled" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar x:Name="ShellNotice" IsOpen="True" IsClosable="True" Severity="Informational" Title="Rozpracovaná Windows verze"
                             Message="Hlavní okno a přehrávání už fungují. Další části postupně dokončujeme." />
                    <ContentControl x:Name="WorkspaceContent" HorizontalContentAlignment="Stretch" />
                    <StackPanel x:Name="NotationPanel" Visibility="Collapsed" Spacing="12">
                <TextBlock Text="Noty a tabulatury" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Nativní náhled první stopy, nejvýše 12 taktů. Poslech zatím používá jednoduchý syntetický strunný zvuk; bicí a ohýbání tónů vyžadují další notový modul."
                           TextWrapping="Wrap" />
                <StackPanel x:Name="ScoreButtons" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="XmlButton" Content="Ukázka MusicXML" Click="Xml_Click" />
                    <Button x:Name="GpButton" Content="Ukázka Guitar Pro" Click="Gp_Click" />
                    <Button x:Name="OpenScoreButton" Content="Otevřít noty…" Click="OpenScore_Click" />
                    <Button x:Name="PlayScoreButton" Content="Přehrát noty" Click="PlayScore_Click" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="NotationStatus" Text="Připravuji notový náhled…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Canvas x:Name="ScoreCanvas" Width="700" Height="1" Background="White" PointerPressed="Score_PointerPressed"
                            AutomationProperties.Name="Notový náhled; výběr taktu kliknutím">
                        <Image x:Name="ScoreImage" Width="700" Stretch="Fill" />
                        <Border x:Name="SelectionBox" BorderBrush="DarkOrange" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Canvas>
                </ScrollViewer>
                <TextBlock x:Name="SelectionStatus" Text="Takt zatím není vybraný." TextWrapping="Wrap" />
                <Button x:Name="ExportMidiButton" Content="Uložit MIDI…" Click="ExportMidi_Click" IsEnabled="False" />
                    </StackPanel>
                <Border x:Name="VideoPanel" Background="{ThemeResource VintagePanel}" Padding="16" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Oficiální YouTube přehrávač. Video a jeho zvuk zůstávají součástí YouTube; žádný zvuk se nestahuje ani nepřevádí." TextWrapping="Wrap" />
                        <TextBox x:Name="VideoUrl" Header="Odkaz na video" PlaceholderText="https://www.youtube.com/watch?v=…" MaxLength="2048" />
                        <StackPanel x:Name="VideoButtons" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="VideoLoadButton" Content="Načíst video" Click="VideoLoad_Click" IsEnabled="False" />
                            <Button x:Name="VideoPlayButton" Content="Přehrát video" Click="VideoPlay_Click" IsEnabled="False" />
                            <Button x:Name="VideoPauseButton" Content="Pozastavit" Click="VideoPause_Click" IsEnabled="False" />
                            <Button x:Name="VideoStopButton" Content="Zastavit video" Click="VideoStop_Click" IsEnabled="False" />
                            <Button Content="V prohlížeči" Click="VideoExternal_Click" />
                        </StackPanel>
                        <ComboBox x:Name="VideoRates" Header="Dostupné rychlosti videa" Width="200" SelectionChanged="VideoRate_Changed" IsEnabled="False" />
                        <TextBlock x:Name="VideoPosition" Text="0:00 / 0:00" />
                        <WebView2 x:Name="VideoView" MaxWidth="640" Height="360" HorizontalAlignment="Stretch" AutomationProperties.Name="Oficiální YouTube přehrávač" />
                        <TextBlock x:Name="VideoStatus" Text="Připravuji přehrávač…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border x:Name="DevicePanel" Background="{ThemeResource VintagePanel}" Padding="16" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Test A · 440 Hz. Použije se výchozí výstup Windows; kytaru tato verze nenahrává."
                                   TextWrapping="Wrap" />
                        <Button x:Name="StartButton" Content="Spustit tón" Click="Start_Click" />
                        <TextBlock x:Name="DeviceText" Text="Zařízení zatím není otevřené." TextWrapping="Wrap" />
                        <TextBlock Text="Velikost bufferu není měření celkové odezvy. Zavření okna zastaví zvuk a uvolní zařízení."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
        <Border x:Name="MediaPanel" Grid.Row="2" Background="{ThemeResource VintagePanel}" Padding="16,8">
            <StackPanel Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MediaTitle" Text="Připrav nahrávku nebo noty" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="15" ValueChanged="Volume_Changed"
                            AutomationProperties.Name="Hlasitost přehrávání" ToolTipService.ToolTip="Hlasitost přehrávání" />
                    <CommandBar x:Name="MediaButtons" Grid.Column="2" DefaultLabelPosition="Collapsed" ClosedDisplayMode="Compact" Background="{ThemeResource VintagePanel}">
                        <AppBarButton x:Name="OpenMediaButton" Label="Otevřít nahrávku" Icon="OpenFile" Click="OpenMedia_Click" />
                        <AppBarButton x:Name="PlayMediaButton" Label="Přehrát" Icon="Play" Click="PlayMedia_Click" IsEnabled="False" />
                        <AppBarButton x:Name="StopButton" Label="Zastavit" Icon="Stop" AccessKey="Z" Click="Stop_Click" IsEnabled="False" />
                        <AppBarButton x:Name="RewindButton" Label="Na začátek" Icon="Previous" Click="Rewind_Click" IsEnabled="False" />
                        <AppBarButton Label="Rychlost přehrávání" Icon="Setting">
                            <AppBarButton.Flyout><Flyout><StackPanel Spacing="12" Width="220">
                            <ComboBox x:Name="SpeedBox" Header="Rychlost" Width="150" SelectedIndex="3" SelectionChanged="Speed_Changed">
                                <ComboBoxItem Content="0,25×" Tag="0.25" />
                                <ComboBoxItem Content="0,5×" Tag="0.5" />
                                <ComboBoxItem Content="0,75×" Tag="0.75" />
                                <ComboBoxItem Content="1×" Tag="1" />
                                <ComboBoxItem Content="1,5×" Tag="1.5" />
                                <ComboBoxItem Content="2×" Tag="2" />
                            </ComboBox>
                                <TextBlock Text="Změna rychlosti zastaví zvuk a připraví nový poslech." TextWrapping="Wrap" />
                            </StackPanel></Flyout></AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                            KeyDown="Position_KeyDown" KeyUp="Position_KeyUp" AutomationProperties.Name="Pozice přehrávání; změna zastaví zvuk" />
                    <TextBlock x:Name="PositionText" Grid.Column="1" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
                <TextBlock x:Name="MediaStatus" Text="Zvuk se spustí až tlačítkem. WAV, MP3, Ogg/Opus, WebM/Opus a Windows MP4/AAC."
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Padding="16,8" Background="{ThemeResource VintagePanel}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Připravuji zvukovou knihovnu…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ShellStateText" Grid.Column="1" Text="Nativní Windows" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
