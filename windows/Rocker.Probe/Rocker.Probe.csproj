<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RockerNativeDll Condition="'$(RockerNativeDll)' == ''">$(MSBuildProjectDirectory)\..\out\native\rocker_audio.dll</RockerNativeDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="AlphaSkia.Native.Windows" Version="3.4.135" />
    <ProjectReference Include="../Rocker.Interop/Rocker.Interop.csproj" />
    <ProjectReference Include="../Rocker.Notation/Rocker.Notation.csproj" />
    <ProjectReference Include="../Rocker.Video/Rocker.Video.csproj" />
    <ProjectReference Include="../Rocker.Domain/Rocker.Domain.csproj" />
    <ProjectReference Include="../Rocker.Infrastructure/Rocker.Infrastructure.csproj" />
    <Content Include="../content/runtime-catalog.json" Link="content/catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Video/*.html;Video/*.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../fixtures/*" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RockerNativeDll)" Link="rocker_audio.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckNativeLibrary" BeforeTargets="Build">
    <Error Condition="!Exists('$(RockerNativeDll)')" Text="Nejprve sestavte nativní knihovnu pomocí windows/build.ps1." />
  </Target>
</Project>
