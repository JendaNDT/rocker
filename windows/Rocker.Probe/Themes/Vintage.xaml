    <Style x:Key="VintageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VintagePanelMaterial}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource VintagePanelStroke}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="VintageInstrumentCardStyle" TargetType="Border" BasedOn="{StaticResource VintageCardStyle}">
        <Setter Property="Background" Value="{ThemeResource VintageFaceMaterial}" />
    </Style>
    <Style x:Key="VintageWorkbenchBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VintagePanelMaterial}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VintagePanelStroke}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="VintageWorkbenchStripStyle" TargetType="Border" BasedOn="{StaticResource VintageWorkbenchBandStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource VintageAccent}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
    </Style>
    <Style x:Key="VintageWorkbenchPaneStyle" TargetType="ScrollViewer">
