        <Setter Property="Fill" Value="{ThemeResource VintageKnobMaterial}" />
        <Setter Property="Stroke" Value="{ThemeResource VintageMetalEdge}" /><Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="VintageDialTickStyle" TargetType="Line"><Setter Property="Stroke" Value="{ThemeResource VintageTick}"/><Setter Property="StrokeThickness" Value="1.5"/></Style>
    <Style x:Key="VintageDialPointerStyle" TargetType="Line"><Setter Property="Stroke" Value="{ThemeResource VintagePointer}"/><Setter Property="StrokeThickness" Value="3"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
