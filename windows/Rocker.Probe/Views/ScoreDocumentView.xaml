<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Rocker.Probe.Views.ScoreDocumentView">
  <Grid x:Name="NotationPanel" Padding="12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ScoreButtons" Orientation="Horizontal" Spacing="6">
        <Button x:Name="OpenScoreButton" Content="Otevřít noty…" />
        <Button x:Name="PlayScoreButton" Content="Přehrát noty" IsEnabled="False" />
        <Button x:Name="ExportMidiButton" Content="Uložit MIDI…" IsEnabled="False" />
        <Button Content="Ukázky">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="8">
                <Button x:Name="XmlButton" Content="Ukázka MusicXML" />
                <Button x:Name="GpButton" Content="Ukázka Guitar Pro" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Grid.Row="1">
      <StackPanel x:Name="NotationControls" Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="NotationTrackBox" Header="Zobrazená a hraná stopa" DisplayMemberPath="Name" Width="200" />
        <ComboBox x:Name="NotationZoom" Header="Zvětšení not" SelectedIndex="2" Width="100">
          <ComboBoxItem Content="50 %" Tag="0.5" />
          <ComboBoxItem Content="75 %" Tag="0.75" />
          <ComboBoxItem Content="100 %" Tag="1" />
          <ComboBoxItem Content="125 %" Tag="1.25" />
          <ComboBoxItem Content="150 %" Tag="1.5" />
          <ComboBoxItem Content="200 %" Tag="2" />
        </ComboBox>
        <CheckBox x:Name="NotationAllTracks" Content="Všechny stopy" />
        <CheckBox x:Name="NotationFollow" Content="Sledovat takt" IsChecked="True" />
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>
      <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Canvas x:Name="ScoreCanvas" Width="700" Height="1" Background="White" AutomationProperties.Name="Notový náhled; výběr taktu kliknutím">
          <Image x:Name="ScoreImage" Width="700" Stretch="Fill" />
          <Border x:Name="NotationPlayhead" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3" Visibility="Collapsed" IsHitTestVisible="False" />
          <Border x:Name="SelectionBox" BorderBrush="{ThemeResource VintageAccent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
        </Canvas>
      </ScrollViewer>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
        <StackPanel Spacing="8">
          <NumberBox x:Name="NotationBar" Header="Vybraný takt" Minimum="1" Maximum="128" Value="1" SpinButtonPlacementMode="Inline" />
          <Button Content="Přejít na vybraný takt" x:Name="Action12" />
          <NumberBox x:Name="NotationLoopFirst" Header="Smyčka od taktu" Minimum="1" Maximum="128" Value="1" SpinButtonPlacementMode="Inline" />
          <NumberBox x:Name="NotationLoopLast" Header="Smyčka do taktu včetně" Minimum="1" Maximum="128" Value="1" SpinButtonPlacementMode="Inline" />
          <ComboBox x:Name="NotationOccurrence" Header="Průchod opakovaným taktem" />
          <Button Content="Použít smyčku taktů" x:Name="Action10" />
          <Button Content="Vypnout smyčku taktů" x:Name="Action11" />
          <TextBlock x:Name="NotationAccessible" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="SelectionStatus" Text="Takt zatím není vybraný." TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock x:Name="NotationStatus" Text="Připravuji notový náhled…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Grid.Row="3" />
  </Grid>
</UserControl>
